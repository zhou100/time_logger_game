# Database settings for testing
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/time_logger_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=time_logger_test

# Application settings
DEBUG=True
ENVIRONMENT=test
LOG_LEVEL=DEBUG

# JWT settings
SECRET_KEY=test_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Port configuration
BACKEND_PORT=10000
FRONTEND_PORT=3000
DB_PORT=5433

# Test specific settings
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/time_logger_test
TEST_MODE=true
OPENAI_API_KEY=dummy_key_for_testing

# ── Anonymous demo / interaction-first landing ─────────────────────────────
# All placeholders — never use these in prod; real values per environment.
PUBLIC_DEMO_ENABLED=true
FLYWHEEL_ENABLED=true
WELCOME_HANDOFF_ENABLED=true
DAILY_DEMO_OPENAI_USD_CAP=5.00
DEMO_IP_HASH_SALT=test-salt-do-not-use-in-prod
DEMO_CLAIM_HMAC_SECRET=test-claim-hmac-secret-do-not-use-in-prod
# Cloudflare's published always-pass test fixtures. Public, documented at
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/ — safe
# to commit. Replace per environment with real keys before going to prod.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
POSTHOG_API_KEY=
SLACK_ALERT_WEBHOOK_URL=
