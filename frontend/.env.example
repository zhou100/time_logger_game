# Frontend env template — copy to .env.local for local development.
# All REACT_APP_* vars are inlined into the bundle at build time; never put
# real secrets here. These are only public identifiers.

# Supabase (primary auth + session storage).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Backend API base URL.
REACT_APP_API_URL=http://localhost:10000

# Cloudflare Turnstile site key (public; paired server-side secret lives in
# backend TURNSTILE_SECRET_KEY).
REACT_APP_TURNSTILE_SITE_KEY=

# PostHog project key (public; used for client-side analytics events).
REACT_APP_POSTHOG_KEY=
# PostHog ingest host. Defaults to US cloud when unset; set to the EU
# equivalent for EU-resident projects. Must match the project region.
REACT_APP_POSTHOG_HOST=https://us.i.posthog.com

# /welcome post-OAuth handoff page. When 'false', the auth footer's redirect
# skips /welcome and lands signed-in users directly on /recording. Defaults
# to 'true' (handoff enabled). The /welcome route still resolves either way —
# this only controls whether OAuth/magic-link redirects route through it.
REACT_APP_WELCOME_HANDOFF_ENABLED=
